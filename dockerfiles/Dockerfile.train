# ─────────────────────────────────────────────────────────────
#  Dockerfile.train — Run Training Pipeline in Docker
# ─────────────────────────────────────────────────────────────
#  Build:  docker build -f dockerfiles/Dockerfile.train -t laptop-train .
#  Run:    docker run -v $(pwd)/project_root/models:/app/project_root/models laptop-train
# ─────────────────────────────────────────────────────────────

FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Run training script on container start
CMD ["python", "project_root/training/train.py"]
